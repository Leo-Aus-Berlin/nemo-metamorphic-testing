TRUE("true"^^<http://www.w3.org/2001/XMLSchema#boolean>).
PI("3.14159"^^<http://www.w3.org/2001/XMLSchema#double>).
CIRC_EARTH("40075000"^^<http://www.w3.org/2001/XMLSchema#double>).
@import endangered :- csv{resource= "data/endangered.csv", format= (string)}.
@import locations :- csv{resource= "data/locations.csv", format= (double, double, skip, skip, skip, skip, skip, skip, skip, skip, skip, skip, string)}.
project("Wind Turbine A").
project_location("Wind Turbine A", "13.69510396381167"^^<http://www.w3.org/2001/XMLSchema#double>, "50.89312291453255"^^<http://www.w3.org/2001/XMLSchema#double>).
project_height_m("Wind Turbine A", 60).
project_species("Wind Turbine A", "Rotmilan").
project_species("Wind Turbine A", "Feldsperling").
project("Wind Turbine B").
project_location("Wind Turbine B", "13.704927907097524"^^<http://www.w3.org/2001/XMLSchema#double>, "50.89816338631804"^^<http://www.w3.org/2001/XMLSchema#double>).
project_height_m("Wind Turbine B", 40).
project_species("Wind Turbine B", "Gartenschläfer").
project("Wind Turbine C").
project_location("Wind Turbine C", "13.688126881341304"^^<http://www.w3.org/2001/XMLSchema#double>, "50.90297432498729"^^<http://www.w3.org/2001/XMLSchema#double>).
project_height_m("Wind Turbine C", 60).
project_species("Wind Turbine C", "Mauersegler").
coordinates(?longitude, ?latitude) :- locations(?longitude, ?latitude, ?tag), TRUE(CONTAINS(?tag, "addr")) .
coordinates_m(?Xm, ?Ym) :- coordinates(?longitude, ?latitude), PI(?PI), CIRC_EARTH(?earth), ?Xm = ?longitude * ?earth * (COS(?latitude / "180"^^<http://www.w3.org/2001/XMLSchema#double> * ?PI)) / "360"^^<http://www.w3.org/2001/XMLSchema#double>, ?Ym = ?latitude * ?earth / "360"^^<http://www.w3.org/2001/XMLSchema#double> .
project_location_m(?project, ?Xm, ?Ym) :- project_location(?project, ?longitude, ?latitude), PI(?PI), CIRC_EARTH(?earth), ?Xm = ?longitude * ?earth * (COS(?latitude / "180"^^<http://www.w3.org/2001/XMLSchema#double> * ?PI)) / "360"^^<http://www.w3.org/2001/XMLSchema#double>, ?Ym = ?latitude * ?earth / "360"^^<http://www.w3.org/2001/XMLSchema#double> .
environmental_impact(?project) :- project_height_m(?project, ?height), ?height >= 50 .
distance(?project, ?distance) :- project_location_m(?project, ?Xp, ?Yp), coordinates_m(?Xr, ?Yr), ?distance = SQRT((POW(?Xp - ?Xr, "2"^^<http://www.w3.org/2001/XMLSchema#double>)) + (POW(?Yp - ?Yr, "2"^^<http://www.w3.org/2001/XMLSchema#double>))) .
project_reject(?project) :- distance(?project, ?distance), ?distance < "200"^^<http://www.w3.org/2001/XMLSchema#double> .
project_reject(?project) :- environmental_impact(?project), project_species(?project, ?species), endangered(?species) .
project_approved(?project) :- project(?project), ~project_reject(?project) .
closest_house(?project, #min(?distance)) :- distance(?project, ?distance) .
@export project_approved :- csv{}.
