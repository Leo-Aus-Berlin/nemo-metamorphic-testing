@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
tooLargeGap(?y) :- platformHeight(?y, ?h), ~allowedDiff(?h, trainHeight) .
mustChangeAt(?y) :- choseB(?x, ?y), choseU(?y, ?z) .
@export validC :- csv{}.
platformHeight(?X_2, "alexanderplatz") :- allowedDiff(trainHeight, ?Y_1), choseU(trainHeight, ?Y_1), platformHeight(?Y_1, ?X_2), mustChangeAt("alexanderplatz"), choseU("alexanderplatz", "alexanderplatz"), ~mustChangeAt("alexanderplatz") .
success(s) :- validC("jungfernheide", "kottbusser_tor"), canChangeAt(?Z_1) .
seeTVTower("str_1").
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y), choseU(?y, ?y) .
platformHeight(trainHeight, c_1).
tooLargeGap("str_2").
allowedDiff(c_2, 9248626437155854463).
tooLargeGap(?X_1) :- validC(?X_1, ?X_1_new_1), seeTVTower("str_1"), mustChangeAt("str_1"), ~allowedDiff("str_1", trainHeight), ~platformHeight(?X_1_new_1, "str_1"), ~choseU(?X_1_new_1, "str_1") .
elevator("str_3").
allowedDiff("kottbusser_tor", 11608093100454351159).
validC(?x, ?y) :- ~choseU(?x, ?y), choseB(?x, ?y), choseU(?y, ?y), ~platformHeight(?y, "jungfernheide"), validC(c_2, ?x) .
allowedDiff(c_3, "str_2").
tooLargeGap("str_4").
seeTVTower(s) :- validC(?x, ?x) .
success(?X_1) :- validC(?X_1, ?X_1), validC(?Y_1, ?X_1) .
