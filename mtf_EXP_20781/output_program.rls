@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
@export validC :- csv{}.
platformHeight("jungfernheide", "alexanderplatz").
platformHeight("kottbusser_tor", ?X_2_new_1) :- choseU("kottbusser_tor", ?X_2), tooLargeGap(?X_2_new_1), ~success(?X_2_new_1, ?X_2, ?X_2_new_1, ?X_2, "kottbusser_tor", trainHeight), ~choseB(?X_2_new_1, trainHeight), ~mustChangeAt("kottbusser_tor"), ~elevator(?X_2_new_1) .
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y) .
mustChangeAt(?y) :- choseU(?x, ?y), choseB(?y, ?z), ~choseB(?y, "alexanderplatz") .
choseB(?X_2, ?X_1) :- validC("kottbusser_tor", ?X_1, ?X_2, ?X_2), choseB(?Y_1, ?X_1), choseU(?X_1, ?Y_1), seeTVTower(?X_1) .
allowedDiff("alexanderplatz", "jungfernheide").
success(?X_4, ?X_3, ?X_3, ?X_3, ?X_2, ?X_5) :- validC(?X_2, ?X_3, ?X_3, ?X_2), tooLargeGap(?X_2), choseU(?X_5, ?X_3), elevator("alexanderplatz"), mustChangeAt(?Y_2), success(?X_3, ?X_4, ?Y_1, ?X_2, ?X_3, ?X_4), ~allowedDiff("jungfernheide", "alexanderplatz"), ~choseB(?X_2, "jungfernheide"), ~choseU("jungfernheide", ?X_2), ~mustChangeAt(?X_3) .
validC("str_1", "alexanderplatz", "kottbusser_tor", "str_2").
tooLargeGap("alexanderplatz") :- success(?Y_1, "alexanderplatz", "alexanderplatz", "alexanderplatz", "alexanderplatz", "alexanderplatz"), elevator(?Y_1), ~seeTVTower(?Y_1), choseU(?Y_1, ?Y_1) .
