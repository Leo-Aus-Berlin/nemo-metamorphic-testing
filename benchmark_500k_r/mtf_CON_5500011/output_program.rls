R_20(?X_5, ?X_2, ?X_4, ?X_1, ?X_3, ?X_6) :- project_species(?X_5, ?X_2), project_species(?X_4, ?X_1), project_species(?X_3, ?X_6), ~project_species(?X_5, ?X_2) .
R_18(c_2, ?X_1, ?X_5, ?X_2, ?X_3) :- R_19(c_2, ?Y_1, ?X_5, ?X_2, ?X_3, ?X_1), ~R_19(c_2, ?Y_1, ?X_5, ?X_2, ?X_3, ?X_1) .
