@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
validC(?x, ?y) :- ~choseU(?x, ?y), choseB(?x, ?y) .
validC(?x, ?y) :- choseU(?x, ?y), ~choseB(?x, ?y) .
mustChangeAt(?y) :- choseU(?x, ?y), choseB(?y, ?z) .
mustChangeAt(?y) :- choseB(?x, ?y), choseU(?y, ?z) .
@export success :- csv{}.
validC(?x, ?z) :- validC(?x, ?y), validC(?y_new_1, ?z), ~mustChangeAt(?y_new_1) .
success(c_1).
platformHeight(c_1, c_2).
validC(c_3, trainHeight).
validC(?x, ?z) :- validC(?x, ?y_new_1), validC(?y, ?z), mustChangeAt(?y_new_1), canChangeAt(?y) .
R_1("jungfernheide", c_4).
R_2("kottbusser_tor").
R_2(?Y_1) :- allowedDiff(?Y_1, ?Y_1), mustChangeAt(?Y_1), choseB(?Y_1, ?Y_1), seeTVTower(?Y_1), allowedDiff("kottbusser_tor", "kottbusser_tor"), ~allowedDiff(?Y_1, ?Y_1), ~canChangeAt(?Y_1), ~elevator(?Y_1) .
canChangeAt(c_5).
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y), success(?y), ~platformHeight(?y, ?y) .
success(s) :- validC("jungfernheide", "kottbusser_tor"), ~elevator(c_1) .
