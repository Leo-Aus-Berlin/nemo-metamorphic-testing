@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
validC(?x, ?y) :- ~choseU(?x, ?y), choseB(?x, ?y) .
