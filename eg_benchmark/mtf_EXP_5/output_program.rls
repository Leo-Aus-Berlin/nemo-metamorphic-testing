@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
validC(?x, ?z) :- validC(?x, ?y), validC(?y, ?z), ~mustChangeAt(?y) .
validC(?x, ?y) :- ~choseU(?x, ?y), choseB(?x, ?y) .
validC(?x, ?y) :- choseU(?x, ?y), ~choseB(?x, ?y) .
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y) .
mustChangeAt(?y) :- choseU(?x, ?y), choseB(?y, ?z) .
mustChangeAt(?y) :- choseB(?x, ?y), choseU(?y, ?z) .
success(s) :- validC("jungfernheide", "kottbusser_tor") .
@export success :- csv{}.
canChangeAt("str_1").
validC(?x, ?z) :- validC(?x, ?y), validC(?y_new_1, ?z), mustChangeAt(?y_new_2), canChangeAt(?y_new_1_new_1) .
success(?X_1) :- validC(?Y_1, ?X_1), choseU(?X_1, "jungfernheide"), choseB(?X_1, ?Y_1_new_1), ~tooLargeGap(?Y_1_new_1), ~elevator(?Y_1), ~platformHeight(?X_1, ?X_1) .
mustChangeAt(?X_1) :- allowedDiff(?X_1, ?X_1), seeTVTower(?Y_1, "alexanderplatz", "alexanderplatz", ?Y_1, ?Y_1), choseU(?Y_1, ?Y_1), elevator("alexanderplatz"), mustChangeAt(?Y_1), ~tooLargeGap("alexanderplatz"), ~elevator(?Y_1), ~seeTVTower("alexanderplatz", ?Y_1, ?Y_1, ?Y_1, "kottbusser_tor") .
elevator("alexanderplatz") :- seeTVTower("str_1", "str_1", "str_1", ?Y_1, ?Y_1), choseB("str_1", ?Y_1), choseU(?Y_1, ?Y_1), elevator("str_1"), platformHeight("alexanderplatz", ?Y_1), seeTVTower("alexanderplatz", "alexanderplatz", "alexanderplatz", "str_1", "alexanderplatz"), ~allowedDiff("str_1", "alexanderplatz") .
canChangeAt("kottbusser_tor").
canChangeAt(?X_1) :- allowedDiff(?Y_1_new_1, ?Y_1), mustChangeAt(?X_1), tooLargeGap(?X_1), ~platformHeight(?X_1, ?X_1), ~choseB("alexanderplatz", ?Y_1), ~allowedDiff(?Y_1_new_1, "alexanderplatz"), ~elevator(?Y_1_new_1) .
choseU(?X_1_new_1, "alexanderplatz") :- platformHeight(?X_1, "alexanderplatz"), choseU(?X_1_new_1, "alexanderplatz"), tooLargeGap(?X_1), ~tooLargeGap(?X_1) .
canChangeAt(?Y_1) :- validC(?Y_1, "jungfernheide"), choseU("jungfernheide", ?Y_1), ~elevator(trainHeight), ~tooLargeGap("jungfernheide") .
