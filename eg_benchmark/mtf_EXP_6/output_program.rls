@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
validC(?x, ?y) :- ~choseU(?x, ?y), choseB(?x, ?y) .
validC(?x, ?y) :- choseU(?x, ?y), ~choseB(?x, ?y) .
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y) .
mustChangeAt(?y) :- choseU(?x, ?y), choseB(?y, ?z) .
mustChangeAt(?y) :- choseB(?x, ?y), choseU(?y, ?z) .
success(s) :- validC("jungfernheide", "kottbusser_tor") .
@export success :- csv{}.
elevator(?X_1) :- mustChangeAt(?X_1) .
success("kottbusser_tor").
seeTVTower(s) :- choseB(?x, "alexanderplatz"), ~mustChangeAt(?x) .
canChangeAt("alexanderplatz").
validC(?X_2, "alexanderplatz") :- seeTVTower("alexanderplatz"), canChangeAt("alexanderplatz"), choseB(?X_2_new_1, ?X_2), choseU(?Y_1, ?Y_1_new_1), platformHeight("kottbusser_tor", "kottbusser_tor"), ~elevator(?Y_1), ~elevator(?Y_1_new_1) .
validC(?x, ?z) :- validC(?x, ?y_new_1_new_1), validC(?y, ?z), mustChangeAt(?y_new_1_new_2), canChangeAt(?y_new_1) .
allowedDiff(c_1, c_2).
validC("str_1", 17951028143924230746).
validC(?X_1_new_1, ?X_1) :- mustChangeAt(?X_1_new_1), mustChangeAt(?X_1), ~platformHeight("alexanderplatz", "alexanderplatz"), ~canChangeAt(?X_1_new_1), ~tooLargeGap(?X_1_new_1) .
validC(?x, ?z) :- validC(?x, ?y), validC(?z, ?z), ~mustChangeAt(?y) .
