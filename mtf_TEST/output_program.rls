@import choseU :- csv{resource= "data/choseU.csv", format= (string, string)}.
@import choseB :- csv{resource= "data/choseB.csv", format= (string, string)}.
@import elevator :- csv{resource= "data/elevator.csv", format= string}.
@import platformHeight :- csv{resource= "data/platformHeight.csv", format= (string, int)}.
@import allowedDiff :- csv{resource= "data/allowedDiff.csv", format= (int, int)}.
tooLargeGap(?y) :- platformHeight(?y, ?h), ~allowedDiff(?h, trainHeight) .
mustChangeAt(?y) :- choseB(?x, ?y), choseU(?y, ?z) .
seeTVTower(s) :- choseB("alexanderplatz", ?x) .
@export validC :- csv{}.
platformHeight("jungfernheide", c_1).
seeTVTower(s) :- choseB(?x, "alexanderplatz") .
tooLargeGap(c_2).
canChangeAt(?y) :- elevator(?y), ~tooLargeGap(?y), elevator(?y), R_4(?y, ?y, trainHeight, ?y, ?y) .
tooLargeGap("alexanderplatz") :- elevator("alexanderplatz"), ~R_1("alexanderplatz") .
platformHeight(?X_2, c_1) :- allowedDiff(?X_2, ?X_2_new_2), choseB(?X_2_new_1, c_1), seeTVTower(?X_2_new_1_new_1), choseU(c_1, c_1), ~allowedDiff(?X_2, c_1), ~choseB(c_1, ?X_2_new_2), ~allowedDiff("kottbusser_tor", c_1), ~seeTVTower(?X_2_new_2) .
tooLargeGap("kottbusser_tor") :- tooLargeGap("alexanderplatz"), R_2(?Y_1, "alexanderplatz", ?Y_1_new_1, "alexanderplatz", "kottbusser_tor", ?Y_1_new_1), R_1(?Y_1), choseU("kottbusser_tor", "kottbusser_tor"), R_4(?Y_1, "kottbusser_tor", "alexanderplatz", "kottbusser_tor", "kottbusser_tor") .
validC(?x, ?z) :- validC(?x, ?y), validC(?y, ?z), mustChangeAt(?y), canChangeAt(?y), ~canChangeAt(?y) .
success(trainHeight) :- validC(?Y_1, ?Y_1), canChangeAt(?Y_1), platformHeight("kottbusser_tor", ?Y_1), platformHeight(?Y_1, "kottbusser_tor") .
